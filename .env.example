# اتصال به MongoDB (لوکال یا Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/autodar

# رمز ورود پنل مدیریت (اگر خالی باشد، ورود بدون رمز است - فقط برای توسعه)
ADMIN_PASSWORD=
AUTH_SALT=change-this-random-string

# ربات تلگرام
TELEGRAM_BOT_TOKEN=
# شناسه چت صاحب نمایشگاه (با ارسال /start به ربات دریافت می‌شود)
TELEGRAM_OWNER_CHAT_ID=
# اگر سرور داخل ایران است، آدرس یک رله/پروکسی برای Bot API (پیش‌فرض: https://api.telegram.org)
TELEGRAM_API_BASE=https://api.telegram.org
# رمز امنیتی وبهوک تلگرام (اختیاری)
TELEGRAM_WEBHOOK_SECRET=

# رمز فراخوانی /api/notify برای کران‌جاب در آینده
NOTIFY_SECRET=
